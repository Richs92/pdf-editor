{
  "name": "documento-pdf-editor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:contracts": "node tests/browser/contracts.mjs",
    "prepare:contracts": "python3 scripts/prepare-contracts.py",
    "test:predial": "node tests/browser/predial.mjs",
    "prepare:predial": "python3 scripts/prepare-predial.py",
    "test:water": "node tests/browser/water.mjs",
    "prepare:water": "python3 scripts/prepare-water.py",
    "test:admin": "node tests/browser/admin.mjs",
    "test:cfe": "node tests/browser/cfe.mjs",
    "test:access": "node --test tests/access.test.mjs tests/schema.test.mjs",
    "test:recovery": "node tests/browser/recovery.mjs",
    "test:ine": "node tests/browser/ine-crop.mjs",
    "test:contract-preview": "node tests/browser/contract-preview.mjs",
    "test:share": "node tests/browser/share.mjs",
    "test:ine-crop": "node tests/browser/ine-crop.mjs",
    "test:signatures": "node tests/browser/signatures.mjs",
    "test:printing": "node tests/browser/printing.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "docx-preview": "0.3.7",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "4.10.38",
    "pdfmake": "0.2.20",
    "pizzip": "3.2.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "playwright": "1.64.1"
  }
}
